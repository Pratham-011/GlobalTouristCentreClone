{
  "redirects": [
    {
      "source": "/destinations/international/phuket-krabi-tour-package",
      "destination": "/destinations/international/",
      "permanent": true
    },
    {
      "source": "/destinations/international/phuket-krabi-tour-package/",
      "destination": "/destinations/international/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|it|de|ru)/destinations/international/phuket-krabi-tour-package",
      "destination": "/:locale/destinations/international/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|it|de|ru)/destinations/international/phuket-krabi-tour-package/",
      "destination": "/:locale/destinations/international/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
